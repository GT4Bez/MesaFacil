# Backend
NODE_ENV=development
PORT=3001
# Gere um valor forte e único para cada ambiente, nunca reutilize este placeholder.
# Comando sugerido: openssl rand -hex 32
JWT_SECRET=changeme

# Conexão com o banco (PostgreSQL)
# Execução local no host:
DATABASE_URL="postgresql://mesafacil:mesafacil@localhost:5432/mesafacil?schema=public"
# Execução interna no devcontainer:
# DATABASE_URL="postgresql://mesafacil:mesafacil@db:5432/mesafacil?schema=public"

# Frontend
VITE_API_URL=http://localhost:3001

# Docker Compose (opcionais)
# Origens liberadas no CORS do backend, separadas por vírgula.
# Padrão do compose: http://localhost:5173,https://mesafacil.shop
# CORS_ORIGIN=http://localhost:5173,https://mesafacil.shop
# Portas publicadas no host
# DB_PORT=5432
# BACKEND_PORT=3001
# FRONTEND_PORT=5173
